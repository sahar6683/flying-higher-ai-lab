    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following business document and create a structured business brief.\n\nExtract only information supported by the document.\nDo not invent or guess.\n\nIdentify:\n- Document type\n- Parties involved\n- Contract value or financial amount\n- Start/effective date\n- End date, if applicable\n- Renewal terms\n- Notice period\n- Key obligations\n- Important dates or deadlines\n- Potential risks or concerns\n- Actions required by Northstar Office Supplies Ltd.\n- Questions for human review\n\nIf information is not present, write \"Not specified\".\n\nDOCUMENT:\n\n{{ $json.data }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
