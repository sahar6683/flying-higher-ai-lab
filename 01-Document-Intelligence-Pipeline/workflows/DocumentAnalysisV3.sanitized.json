    {
      "parameters": {
        "sendTo": "<YOUR_TARGET_INBOX@example.com>",
        "subject": "=Northstar Document Review - {{ $json.output.number_of_documents }} Documents",
        "message": "=<h2> Northstar AI Document Review</h2>\n\n<h3>Overview</h3>\n\n<p>\n<strong>Number of Documents:</strong><br>\n{{ $json.output.number_of_documents }}\n</p>\n\n<p>\n<strong>Document Types:</strong><br>\n{{ $json.output.types_of_documents.join(\"<br>\") }}\n</p>\n\n<hr>\n\n<h3>📋 Management Summary</h3>\n\n<p>\n{{ $json.output.brief_summary }}\n</p>\n\n<hr>\n\n<h3>⚠️ Human Review Status</h3>\n\n<p>\n<strong>{{ $json.documents.filter(d => d.review_status === \"HUMAN REVIEW REQUIRED\").length }}\nof {{ $json.documents.length }} documents require human review.</strong>\n</p>\n\n<p>\n{{ $json.output.human_attention.join(\"<br>• \") }}\n</p>\n\n<hr>\n\n<h3>💰 Key Financial Commitments</h3>\n\n<p>\n• {{ $json.output.key_financial_commitments.join(\"<br>• \") }}\n</p>\n\n<h3>📅 Important Dates</h3>\n\n<p>\n• {{ $json.output.important_dates.join(\"<br>• \") }}\n</p>\n\n<h3>🔴 Action Items</h3>\n\n<p>\n• {{ $json.output.action_items.join(\"<br>• \") }}\n</p>\n\n<hr>\n\n<p>\n<em>This briefing was automatically generated by the Northstar AI document workflow.</em>\n</p>",
        "options": {}
      },
