flowchart LR
    subgraph V1[v1: Category-first + 85% confidence]
        A1([Gmail Trigger]) --> B1[Prepare Email]
        B1 --> C1[Jev — Classify Email<br/>category]
        C1 --> D1{{If — Confidence Check<br/>confidence <= 0.85}}
        D1 -- yes --> E1[Prepare Human Review Output]
        E1 --> F1[Google Sheets: append row]
        E1 --> G1[Gmail: notify reviewer]
        D1 -- no --> H1[Jev — Assess Priority<br/>priority]
        H1 --> I1[Gmail: classify & forward]
    end

    subgraph V2[v2: Urgency-score-first + dual gate + Slack routing]
        A2([Gmail Trigger]) --> B2[Prepare Email]
        B2 --> C2{Jev — urgency score}
        C2 -- score >= 6 --> D2[Human Review Output]
        D2 --> F2[Sheets: append]
        D2 --> G2[Gmail: notify reviewer]
        C2 -- score < 6 --> E2{Jev — category choice}
        E2 --> S2{{Switch by category}}
        S2 --> H2a[Slack #sales]
        S2 --> H2b[Slack #purchasing]
        S2 --> H2c[Slack #billing]
        S2 --> H2d[Slack #customer-experience]
        S2 --> H2e[Slack #operations]
        C2 -- confidence <= 0.6 --> K2[Human Review Output2]
        K2 --> F2b[Sheets: append]
        K2 --> G2b[Gmail: notify reviewer]
    end

    V1 --> V2
