    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const answers = $json.answers;\n\nconst missingFields = [];\n\nif (answers.missing_quantity?.noul >= 0.5) {\n  missingFields.push(\"quantity\");\n}\n\nif (answers.missing_budget?.noul >= 0.5) {\n  missingFields.push(\"estimated budget\");\n}\n\nif (answers.missing_required_by?.noul >= 0.5) {\n  missingFields.push(\"required-by date\");\n}\n\n// Create readable text\nlet missingText = \"\";\n\nif (missingFields.length === 1) {\n  missingText = missingFields[0];\n} else if (missingFields.length === 2) {\n  missingText = `${missingFields[0]} and ${missingFields[1]}`;\n} else if (missingFields.length === 3) {\n  missingText = `${missingFields[0]}, ${missingFields[1]}, and ${missingFields[2]}`;\n}\n\nreturn {\n  json: {\n    ...$json,\n    missing_count: missingFields.length,\n    missing_fields: missingFields,\n    missing_text: missingText\n  }\n};"
      },
