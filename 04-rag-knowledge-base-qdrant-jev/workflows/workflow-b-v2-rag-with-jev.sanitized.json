        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"typesafe/jev-1.13-20260917\",\n  \"state\": {\n    \"question\": {{ JSON.stringify($json.question) }}\n  },\n  \"questions\": {\n    \"issue_type\": {\n      \"type\": \"choice\",\n      \"criteria\": {\n        \"Delivery\": \"Choose Delivery when the customer asks about late, lost, missing or delayed deliveries, tracking, delivery address changes, delivery times or delivery fees.\",\n        \"Return_Refund\": \"Choose Return_Refund when the customer asks about returns, exchanges, refunds, a wrong item received, or an item that arrived damaged or faulty.\",\n        \"Product_Question\": \"Choose Product_Question when the customer asks about product specifications, features, compatibility, usage, care instructions or warranty coverage.\",\n        \"Order_Account\": \"Choose Order_Account when the customer asks about placing, changing or cancelling an order, payment methods, invoices, billing address corrections, or their account details.\",\n        \"Complaint\": \"Choose Complaint when the customer expresses dissatisfaction with service, staff, communication or their overall experience, or asks how to make a complaint.\",\n        \"Safety_Privacy\": \"Choose Safety_Privacy when the question involves an injury or safety incident, fraud, unauthorised account access, or data and privacy concerns.\",\n        \"Other\": \"Choose Other only when the question clearly does not fit any of the categories above.\"\n      },\n      \"instructions\": \"Choose the single issue type that best matches the customer's main need. Judge by what the customer is actually asking for, not by individual keywords. If a question touches on more than one topic, choose the category of the primary request. Choose Safety_Privacy whenever safety, fraud or personal data is involved, even if another category also fits. Use Other only as a last resort.\"\n    },\n    \"escalation_priority\": {\n      \"type\": \"choice\",\n      \"criteria\": {\n        \"Urgent\": \"Choose Urgent when there is a safety risk, injury, suspected fraud, unauthorised account access, a data breach, or a legal or regulatory threat. These must go to a human immediately.\",\n        \"High\": \"Choose High when the customer is clearly angry or distressed, reports a repeated or unresolved problem, has been waiting a long time, or faces a significant financial or time-sensitive impact such as a missing high-value order or a charge dispute.\",\n        \"Medium\": \"Choose Medium when the customer has a real problem that needs action, such as a late delivery, a faulty item, a refund request or a billing correction, but is calm and there is no serious time pressure or risk.\",\n        \"Low\": \"Choose Low when the customer is asking a general informational question, such as how a policy works, product details, how to place or change an order, or how to make a request, and nothing has gone wrong yet.\"\n      },\n      \"instructions\": \"Assess how urgently this question needs attention and whether it should be escalated to a human. Base the decision on risk, customer emotion, financial impact and time sensitivity, not on the topic alone. A simple how-to question is Low even if it is about refunds or deliveries. Choose Urgent for any safety, fraud, security or legal issue regardless of tone. When torn between two levels, choose the higher one.\"\n    }\n  }\n}",
        "options": {}
      },
