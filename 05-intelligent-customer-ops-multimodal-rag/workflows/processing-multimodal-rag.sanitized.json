    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer Query:\n{{ $('Loop Over Items').item.json.description }}\n\nCustomer Order Number Provided:\n{{ $('Loop Over Items').item.json.order_number || 'None provided' }}\n\nPhoto / Attachment Filename:\n{{ $('Loop Over Items').item.json.photo_drive_link || 'None' }}\n\nAttached Image Inspection (from Vision Model):\n{{ $json.text ? $json.text : 'No image attached' }}\n\nRetrieved Qdrant Policy Chunks:\n{{ $('Aggregate').item.json.data.map((item, i) => `--- CHUNK ${i+1} | Source: ${item.document.metadata.source} (Chunk ${item.document.metadata.chunk_id}, Score: ${item.score.toFixed(4)}) ---\\n${item.document.pageContent}`).join('\\n\\n') }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a strict RAG Policy Evaluator for Northstar Supplies Ltd. Your job is to compare the Customer Query against the Retrieved Qdrant Policy Chunks and evaluate whether the retrieved documents contain the answer.  Follow these strict rules: 1. ONLY use facts explicitly stated in the Retrieved Qdrant Policy Chunks. Never invent policies, fees, or timelines. 2. Check EVERY part of the customer's question:    - Choose \"Yes\" ONLY if the retrieved chunks fully cover the policy/workflow needed to handle the customer's request.    - Choose \"Partial (Policy Gap)\" if the chunks answer part of the question, OR if the customer asks a specific question (e.g., who pays return postage, compatibility, price match) that is NOT stated in the retrieved chunks.    - Choose \"Needs Clarification (Vague)\" if the customer's message is too vague to know what they are asking, or is missing critical context.    - Choose \"No\" if the retrieved chunks are completely unrelated to the customer's question. 3. In \"relevant_files\", list ONLY the source filenames from the retrieved chunks that actually contain relevant rules for this query (ignore unrelated chunks that just happened to be in the top 4). 4. In \"missing_or_gap\", explicitly state what information is missing from the policy chunks OR what verification/evidence (e.g., photo review, order verification code, human approval) is required before a final answer. If there is no policy gap, write \"None (standard verification/approval applies)\"."
            }
          ]
        },
        "batching": {}
      },
